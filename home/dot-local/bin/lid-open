#!/bin/bash

# NUM_MONS=$(hyprctl -j monitors | jq length)
#
# if [ "$NUM_MONS" -gt 1 ]; then
# 	hyprctl dispatch dpms on eDP-1
# fi
if ! hyprctl -j monitors | jq '.[].name' | grep -q "eDP-1"; then
    hyprctl eval 'hl.monitor({ output = "eDP-1", mode = "2256x1504@59.999", position = "0x0", scale = 1.33203125 })'
fi
